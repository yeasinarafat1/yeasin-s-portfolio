# Copy the pooled PostgreSQL connection string from your Neon project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Required for /admin. Use a long unique password and a random secret of 32+ characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional; defaults to ADMIN_SESSION_SECRET or DATABASE_URL.
CONTACT_RATE_LIMIT_SECRET=
